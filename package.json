{
  "name": "converse",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:claim": "node --env-file-if-exists=.env scripts/claim-conversations.js",
    "test:neon": "node --env-file=.env.neon-test --test test/neon.test.js",
    "test:browser": "playwright test",
    "test:auth:browser": "playwright test --config=playwright.auth.config.js",
    "test:agent:browser": "playwright test --config=playwright.agent.config.js",
    "format": "prettier --write api lib public/app.js public/ui.js public/index.html public/styles.css public/sw.js scripts test playwright.config.js README.md package.json vercel.json"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@playwright/test": "^1.63.0",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8",
    "@vercel/functions": "^3.9.9",
    "drizzle-orm": "^0.45.3",
    "gpt-tokenizer": "^4.0.0",
    "htmlparser2": "^12.0.0",
    "pg": "^8.23.1"
  }
}
