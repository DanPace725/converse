OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
APP_PASSWORD=
JEV_API_KEY=

# Google sign-in through Neon Auth. SESSION_SECRET (32+ random characters)
# turns it on and replaces APP_PASSWORD; only ALLOWED_EMAILS (comma-separated)
# can sign in. Locally, open http://localhost:3211, not 127.0.0.1.
SESSION_SECRET=
ALLOWED_EMAILS=

# Populated locally by neon env pull --file .env.
# Context chats use DATABASE_URL; migrations use the direct connection.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Embeddings use OPENAI_API_KEY; off disables paid semantic indexing/search.
CONCLAVE_EMBEDDINGS=on
# Enable briefly to log aggregate saved-load timings/counts; no chat text.
CONCLAVE_LOAD_DIAGNOSTICS=off
